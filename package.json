{
  "name": "@linkerestate/sdk",
  "version": "1.6.1",
  "description": "Official client for the Linkerestate API: agent rotation, lead capture and property catalog.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "exports": {
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "default": "./dist/catalog.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsc --noEmit && tsup"
  },
  "keywords": [
    "linkerestate",
    "real-estate",
    "crm",
    "leads",
    "round-robin"
  ],
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/converteamdo/linkerestate-sdk.git"
  },
  "homepage": "https://github.com/converteamdo/linkerestate-sdk#readme",
  "bugs": {
    "url": "https://github.com/converteamdo/linkerestate-sdk/issues"
  }
}
